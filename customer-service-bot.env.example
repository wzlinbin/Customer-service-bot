# Copy this file to customer-service-bot.env in the project directory.
# Do not commit the real file because it contains secrets.
TG_BOT_TOKEN=
TG_ADMIN_ID=
CHAT_API_KEY=

# Browser origins allowed to call this service directly, separated by commas.
CHAT_ALLOWED_ORIGINS=https://api.api2cn.com
CHAT_ALLOWED_ORIGIN_REGEX='(?i)^https?://(?:127\.0\.0\.1|localhost)(?::\d+)?$'

# Runtime and local storage.
APP_HOST=127.0.0.1
APP_PORT=8000
CHAT_DB_FILE=chat.db
CHAT_DATA_RETENTION_HOURS=24
CHAT_CLEANUP_INTERVAL_SECONDS=3600

# Chat request limits.
CHAT_POLL_LIMIT=50
CHAT_MAX_SESSION_ID_LENGTH=100
CHAT_MAX_NICKNAME_LENGTH=50
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_UPLOAD_BYTES=10485760

# Telegram polling and network timings.
TG_HTTP_TIMEOUT_SECONDS=20
TG_LONG_POLL_TIMEOUT_SECONDS=10
TG_POLL_INTERVAL_SECONDS=1
TG_RETRY_DELAY_SECONDS=5
